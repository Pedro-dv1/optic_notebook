ENVIRONMENT=development
DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-development-key
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
DB_NAME=optic_notebook
DB_USER=optic_notebook
DB_PASSWORD=replace-with-a-database-password
DB_HOST=localhost
DB_PORT=5432
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=7
# Leave EMAIL_PROVIDER empty only when account-security e-mail flows are not used locally.
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-a-resend-api-key
DEFAULT_FROM_EMAIL="OpticNoteBook <no-reply@your-verified-domain.example>"
PLATFORM_NAME=OpticNoteBook
PLATFORM_SUPPORT_EMAIL=support@example.com
PLATFORM_ADMIN_EMAIL=admin@example.com
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
REFRESH_COOKIE_SAMESITE=Lax
TURNSTILE_REQUIRED=False
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=localhost
